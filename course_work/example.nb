In[57]:= (*Точки*)points={{0,2},{1,3},{2,6}};
n=Length[points]-1;
h=Table[points[[i+1,1]]-points[[i,1]],{i,1,n}];
y=points[[All,2]];

(*Правая часть*)
d=Table[0,{i,0,n}];
For[i=2,i<=n,i++,d[[i]]=(y[[i+1]]-y[[i]])/h[[i]]-(y[[i]]-y[[i-1]])/h[[i-1]];];

(*Матрица*)
A=Table[0,{n+1},{n+1}];
A[[1,1]]=1;A[[n+1,n+1]]=1;(*граничные*)For[i=2,i<=n,i++,A[[i,i-1]]=h[[i-1]]/6;
A[[i,i]]=(h[[i-1]]+h[[i]])/3;
A[[i,i+1]]=h[[i]]/6;];

(*Решение*)
M=LinearSolve[A,d];
Print["M = ",M];
