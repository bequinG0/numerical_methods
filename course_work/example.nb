In[42]:= (*Функция*)f[x_]:=Sin[x];

(*Узлы*)
points=Table[{x,f[x]},{x,{0,Pi/4,Pi/2}}];

(*Полином Лагранжа*)
L[x_]=InterpolatingPolynomial[points,x];
Print["L(x) = ",Simplify[L[x]]];

(*Погрешность*)
error[x_]=f[x]-L[x];

(*Оценка сверху*)
M3=MaxValue[{Abs[D[f[x],{x,3}]],0<=x<=Pi/2},x];
omega[x_]=Product[(x-points[[i,1]]),{i,1,Length[points]}];
maxOmega=MaxValue[{Abs[omega[x]],0<=x<=Pi/2},x];
bound=M3/6*maxOmega;
Print["M3 = ",M3];
Print["max |omega| = ",maxOmega];
Print["Теоретическая оценка = ",N[bound]];

(*Максимальная фактическая погрешность*)
maxError=MaxValue[{Abs[error[x]],0<=x<=Pi/2},x];
Print["Фактическая max погрешность = ",N[maxError]];

(*График погрешности*)
Plot[error[x],{x,0,Pi/2},PlotLabel->"Погрешность интерполяции sin x",AxesLabel->{"x","f(x) - L(x)"},Filling->Axis]
