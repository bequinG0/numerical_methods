In[37]:= (*Точки*)points={{0,2},{1,3},{2,6}};

(*Полином Лагранжа вручную*)
n=Length[points]-1;
L[x_]:=Sum[points[[i+1,2]]*Product[If[i==j,1,(x-points[[j+1,1]])/(points[[i+1,1]]-points[[j+1,1]])],{j,0,n}],{i,0,n}];

