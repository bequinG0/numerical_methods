In[1]:=

(*Параметры*)h=10^-1;(*укрупнил для наглядности*)x0=0;
y0=1;
xStart=-1;
xEnd=1;

(*Точное решение*)
exact[x_]:=Exp[x];

(*Универсальный метод Эйлера:от x0 до xEnd*)
EulerSolve[x0_,y0_,xEnd_,h_]:=Module[{nSteps,hSigned,x,y,result,i},nSteps=Round[Abs[(xEnd-x0)/h]];
hSigned=Sign[xEnd-x0]*Abs[h];
x=x0;
y=y0;
result=Table[0,{i,0,nSteps}];
result[[1]]={x,y};
For[i=1,i<=nSteps,i++,y=y+hSigned*y;(*f(x,y)=y*)x=x+hSigned;
result[[i+1]]={x,y};];
Return[result];];

(*Один вызов влево,один вправо*)
left=EulerSolve[x0,y0,xStart,h];
right=EulerSolve[x0,y0,xEnd,h];

(*Склеиваем*)
full=Join[Reverse[Drop[left,-1]],right];

(*График*)
Show[ListLinePlot[full,PlotStyle->{Red,Thick},PlotLegends->{"Euler"}],Plot[exact[x],{x,xStart,xEnd},PlotStyle->{Blue,Dashed},PlotLegends->{"Exact"}],AxesLabel->{"x","y"},PlotLabel->"Euler method: y' = y, y(0) = 1"]
