In[76]:= (*Точки для интерполяции*)points={{0,2},{1,3},{2,6}};
xVals=points[[All,1]];
yVals=points[[All,2]];
n=Length[points];

(*Кубический сплайн (k=4)*)
k=4;

(*Расширенный вектор узлов:кратные концы+внутренние узлы*)
a=xVals[[1]];
b=xVals[[-1]];
t=Join[Table[a,{k}],Table[a+i*(b-a)/(n-1),{i,1,n-2}],Table[b,{k}]];
Print["Вектор узлов t = ",t];

(*Число B-сплайнов*)
nBasis=Length[t]-k;
Print["Число B-сплайнов = ",nBasis];

(*Базисные функции*)
B[i_,x_]:=BSplineBasis[{k-1,t},i,x];

(*График всех B-сплайнов*)
Print["=== Базисные функции ==="];
Plot[Table[B[i,x],{i,0,nBasis-1}],{x,a,b},PlotRange->All,PlotLegends->Table["B"<>ToString[i],{i,0,nBasis-1}],AxesLabel->{"x","B_{i,k}(x)"},PlotLabel->"Кубические B-сплайны",Filling->Axis]

(*Матрица системы:A_{i,j}=B_j(x_i)*)
A=Table[B[j,xVals[[i+1]]],{i,0,n-1},{j,0,nBasis-1}];
Print["Матрица системы A:"];
MatrixForm[A]

(*Решаем Ac=y*)
c=LinearSolve[A,yVals];
Print["Коэффициенты c = ",c];

(*Построенный сплайн*)
S[x_]:=Sum[c[[j+1]]*B[j,x],{j,0,nBasis-1}];

(*Сравнение с встроенным сплайном*)
builtin=Interpolation[points,Method->"Spline",InterpolationOrder->3];

(*График:точки,B-сплайн,встроенный сплайн*)
Print["=== Результат ==="];
Show[ListPlot[points,PlotStyle->{Red,PointSize[0.03]},PlotLegends->{"Точки"}],Plot[S[x],{x,a,b},PlotStyle->{Blue,Thick},PlotLegends->{"B-сплайн"}],Plot[builtin[x],{x,a,b},PlotStyle->{Green,Dashed,Thick},PlotLegends->{"Встроенный"}],AxesLabel->{"x","y"},PlotLabel->"Интерполяция B-сплайнами"]

(*Проверка*)
Print["Проверка в точках:"];
TableForm[Table[{xVals[[i]],S[xVals[[i]]],yVals[[i]]},{i,1,n}],TableHeadings->{None,{"x","S(x)","y"}}]
