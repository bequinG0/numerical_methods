In[67]:= (*Точки*)points={{0,2},{1,3},{2,6}};

(*Естественный кубический сплайн*)
spline=Interpolation[points,Method->"Spline",InterpolationOrder->3];

(*Наш ручной сплайн для проверки*)
S0[x_]:=2+0.5 x+0.5 x^3;
S1[x_]:=3+2 (x-1)+1.5 (x-1)^2-0.5 (x-1)^3;
S[x_]:=Piecewise[{{S0[x],0<=x<=1},{S1[x],1<x<=2}}];

(*График*)
Show[Plot[{spline[x],S[x]},{x,0,2},PlotStyle->{{Blue,Thick},{Red,Dashed}},PlotLegends->{"Встроенный","Ручной"}],ListPlot[points,PlotStyle->{PointSize[0.03],Green}],PlotLabel->"Кубический сплайн",AxesLabel->{"x","y"}]

(*Вывод формул*)
Print["S0(x) = ",Simplify[S0[x]]];
Print["S1(x) = ",Simplify[S1[x]]];

(*Таблица значений*)
TableForm[Table[{x,S[x]},{x,0,2,0.25}],TableHeadings->{None,{"x","S(x)"}}]
